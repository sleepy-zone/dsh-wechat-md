{
  "name": "@local/wechat-md",
  "version": "1.2.0",
  "private": true,
  "description": "Typeset Markdown with doocs/md themes and copy it to the WeChat official-account editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleepy-zone/dsh-wechat-md.git"
  },
  "homepage": "https://github.com/sleepy-zone/dsh-wechat-md#readme",
  "bugs": {
    "url": "https://github.com/sleepy-zone/dsh-wechat-md/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "markdown",
    "wechat",
    "doocs-md",
    "wechat-editor"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src/*.js",
    "src/build.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
